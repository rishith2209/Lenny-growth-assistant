# ==============================================================================
# Lenny Growth Assistant — Environment Configuration (.env.example)
# All defaults are pre-configured for local ₹0 spend (Ollama + PostgreSQL + Pi)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0
PI_BRIDGE_URL=http://localhost:4001

# PostgreSQL + pgvector Database
# If running FastAPI on host connecting to Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# Sync database URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_PORT=5432

# Ollama Local LLM Runtime (Host-managed on Windows)
OLLAMA_BASE_URL=http://localhost:11434
# For containers reaching host Ollama on Windows/Mac:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model Selection Hierarchy
PRIMARY_MODEL=llama3.1:8b
FALLBACK_MODEL=qwen3:4b
REASONING_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Pi Coding Agent Runtime Configuration
PI_AGENT_VERSION=0.74.2
PI_SESSION_TIMEOUT_SECONDS=300

# Transcript Corpus Ingestion Configuration
TRANSCRIPT_SOURCE_REPO=https://github.com/ChatPRD/lennys-podcast-transcripts.git
TRANSCRIPT_CACHE_DIR=.cache/transcripts
INGEST_BATCH_SIZE=32

# Optional Commercial Providers (Strictly Optional — Disabled by default for ₹0 demo)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
